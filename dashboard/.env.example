# Copy to .env — NEVER commit .env
JANMAT_API_URL=https://janmat-backend-XXXX-uc.a.run.app
SESSION_SECRET=change_me_random_64_chars
PORT=3000

# Google Maps API key (for heatmap)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google OAuth 2.0
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback (dev)
#                          https://your-dashboard.run.app/auth/google/callback (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Comma-separated list of Google email addresses authorized to access this dashboard
# Add the MP's Google account email and any authorized staff
ALLOWED_MP_EMAILS=mp@janmat.demo,quantumduobuilder@gmail.com

# Demo fallback login (when Google OAuth not configured)
DEMO_MODE=true
DEMO_USER=mp@janmat.demo
DEMO_PASS=JanMat@2025!
